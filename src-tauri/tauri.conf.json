{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AGY BYOK",
  "version": "1.0.2",
  "identifier": "com.yuzhiqiang.agy-byok",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "width": 1360,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 760,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "Custom model proxy for Antigravity IDE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQyRTU4MTgwM0RFQ0E1MTUKUldRVnBldzlnSUhsUXJYbVlPZkpaU0xWcVp3bjdnL3daSHF5S3FheE83ZVVqM3h2Y1c4aVJVdnoK",
      "endpoints": [
        "https://github.com/yuzhiqiang1993/agy-byok/releases/latest/download/latest.json"
      ]
    }
  }
}
