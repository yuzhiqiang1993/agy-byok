{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AGY BYOK",
  "version": "0.1.0",
  "identifier": "com.yuzhiqiang.agy-byok",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AGY BYOK",
        "width": 1060,
        "height": 780,
        "minWidth": 860,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "shortDescription": "Custom model proxy for Antigravity IDE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
